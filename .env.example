# Every env var the service reads. Never commit real values - this file is the
# schema, not the secret store. Validated at boot (src/config/env.validation.ts).

# development | production | test (default: development)
NODE_ENV=development

# HTTP port (default: 3000)
PORT=3000

# fatal | error | warn | info | debug | trace | silent (default: info)
LOG_LEVEL=info
